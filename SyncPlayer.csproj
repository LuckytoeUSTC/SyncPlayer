<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>4.0.0</Version><AssemblyName>SyncPlayer</AssemblyName>
    <Product>SyncPlayer</Product>
    <ApplicationIcon>src/UI/Assets/app.ico</ApplicationIcon>
    <Description>One-way PotPlayer synchronization through a relay.</Description>
    <DebugType>none</DebugType>
    <DefineConstants Condition="'$(EnableDiagnostics)' == 'true'">$(DefineConstants);DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <EmbeddedResource Include="src/UI/Assets/language.png" LogicalName="SyncPlayer.LanguageIcon.png" />
    <EmbeddedResource Include="src/UI/Assets/app.ico" LogicalName="SyncPlayer.AppIcon.ico" />
    <Compile Include="tests/**/*.cs" Condition="'$(EnableDiagnostics)' == 'true'" />
    <EmbeddedResource Remove="programs-for-reference/**/*" />
    <None Remove="programs-for-reference/**/*" />
    <None Remove="diagnostics/**/*;artifacts/**/*;test-video/**/*;.build-profile/**/*" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.zh-*.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Update="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="licenses/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="relay.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>



